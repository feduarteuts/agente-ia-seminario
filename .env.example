# ============================================================
#  .env.example — Plantilla de variables de entorno
#  Sesión 5 — Agente IA con FastAPI
#
#  INSTRUCCIONES:
#  1. Copia este archivo como .env
#  2. Completa cada variable con tus valores reales
#  3. NUNCA subas el .env a GitHub
# ============================================================

# ── PROVEEDOR LLM ─────────────────────────────────────────
LLM_PROVIDER=groq

# ── GROQ ──────────────────────────────────────────────────
GROQ_API_KEY=tu_clave_aqui
# Opciones vigentes: openai/gpt-oss-120b | openai/gpt-oss-20b | qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b

# ── OLLAMA (opcional, solo para uso local) ────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── AGENTE ────────────────────────────────────────────────
AGENT_NAME=Asistente
AGENT_ROLE=asistente general útil y conciso
TEMPERATURE=0.7
MAX_TOKENS=1024

# ── APIs EXTERNAS ─────────────────────────────────────────
OPENWEATHER_API_KEY=tu_clave_aqui
CIUDAD_DEFAULT=Bogota

# ── FASTAPI ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
